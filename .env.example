DRYAD_DOMAIN=datadryad.org
DRYAD_CLIENT_ID=your_client_id_here
DRYAD_CLIENT_SECRET=your_client_secret_here

USE_EXISTING_DATASET=true
EXISTING_DATASET_IDENTIFIER=doi%3A10.5061%2Fdryad.example

MAX_RETRIES=5
RETRY_DELAY_SECONDS=15

DRY_RUN=true
REQUIRE_CONFIRMATION=true
ALLOW_EXISTING_REMOTE_FILES=false